rules_version = '2';
// Only YOU (signed in with your email) can read or change the schedule.
// Replace YOUR_EMAIL@example.com with the email you used in Firebase Authentication,
// then paste this whole file into Firebase → Firestore Database → Rules → Publish.
// (The GitHub email robot uses a service key, which does not need these rules.)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == "YOUR_EMAIL@example.com";
    }
  }
}
